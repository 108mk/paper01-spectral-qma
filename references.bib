@article{ZHAO20043,
title = {(2+f(n))-SAT and its properties},
journal = {Discrete Applied Mathematics},
volume = {136},
number = {1},
pages = {3-11},
year = {2004},
note = {Discrete Mathematics and Theoretical Computer Science (DMTCS)},
issn = {0166-218X},
doi = {https://doi.org/10.1016/S0166-218X(03)00194-X},
url = {https://www.sciencedirect.com/science/article/pii/S0166218X0300194X},
author = {Yunlei Zhao and Xiaotie Deng and C.H Lee and Hong Zhu},
keywords = {Computational complexity, SAT, Exponential-time hypothesis},
abstract = {Consider a formula that contains n variables with the form Φ=Φ2∧Φ3, where Φ2 is an instance of 2-SAT containing m2 2-clauses and Φ3 is an instance of 3-SAT containing m3 3-clauses. Φ is an instance of (2+f(n))-SAT if m3/(m2+m3)⩽f(n). We prove that (2+f(n))-SAT is in P if f(n)=O(logn/n2), and in NPC if f(n)=1/n2−ε(∀ε:0<ε<2). Most interestingly, we give a candidate, (2+(logn)k/n2)-SAT (k⩾2), for natural problems in NP−NPC−P (denoted as NPI) with respect to this (2+f(n))-SAT model. We prove that the restricted version is not in NPC under P≠NP. In fact, it is in NPI under a stronger but plausible assumption, namely the exponential-time hypothesis.}
}

